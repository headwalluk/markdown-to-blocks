{
  "name": "@headwall/markdown-to-blocks",
  "version": "1.4.0",
  "description": "Convert Markdown into serialised WordPress/Gutenberg block markup (core blocks, with <!-- wp:... --> delimiters).",
  "keywords": [
    "markdown",
    "wordpress",
    "gutenberg",
    "blocks",
    "remark",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Paul Faulkner <paul@headwall-hosting.com>",
  "homepage": "https://github.com/headwalluk/markdown-to-blocks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/headwalluk/markdown-to-blocks.git"
  },
  "bugs": {
    "url": "https://github.com/headwalluk/markdown-to-blocks/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "md2blocks": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@wordpress/block-library": "^12.2.0",
    "@wordpress/blocks": "^17.2.0",
    "jsdom": "^31.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vitest": "^5.1.1",
    "yaml": "^2.6.1"
  }
}
